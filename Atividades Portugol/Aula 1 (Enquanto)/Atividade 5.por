programa {
  funcao inicio() {
    inteiro tabuada, tabu=1
    escreva ("Digite o numero que voce quer ver a tabuada (1 a 10): ")
    leia (tabuada)
    enquanto (tabu<=10){
      escreva (tabuada," * ",tabu," = ",tabuada*tabu,"\n")
      tabu++
    }
  }
}

